# ═══════════════════════════════════════════════════════════════
# LOGGI-FLOW - Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Bitrix24

# Lalamove (produção)
LALAMOVE_API_KEY=your-api-key
LALAMOVE_API_SECRET=your-api-secret
LALAMOVE_BASE_URL=https://rest.lalamove.com

# n8n Webhooks
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook

# Google Maps (para MapaRotas)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key

# App Settings
VITE_APP_NAME=Loggi-Flow
VITE_APP_ENV=development

# Sentry (monitoramento de erros — vazio desativa o Sentry.init)
VITE_SENTRY_DSN=""

# Seed script (apenas local/dev, NUNCA commit o valor real)
# Use a SERVICE ROLE KEY do painel Supabase (Settings > API > service_role).
# Permissão admin — bypassa RLS. Não exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-seed-only

# Feature Flags
VITE_ENABLE_GAMIFICATION=true
VITE_ENABLE_LALAMOVE=true
VITE_ENABLE_BITRIX24_SYNC=true

# Centro de distribuicao usado como origem das rotas no mapa (padrao: SP Central)
VITE_CD_ORIGEM_LAT=-23.5505
VITE_CD_ORIGEM_LNG=-46.6333
