# ═══════════════════════════════════════════════════════════════
# LOGGI-FLOW - Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Bitrix24
VITE_BITRIX24_WEBHOOK=https://promobrindes.bitrix24.com.br/rest/1/your-token/

# Lalamove (produção)
LALAMOVE_API_KEY=your-api-key
LALAMOVE_API_SECRET=your-api-secret
LALAMOVE_BASE_URL=https://rest.lalamove.com

# n8n Webhooks
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook

# Google Maps (para MapaRotas)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Mapbox (token público pk.* usado pelos mapas client-side)
VITE_MAPBOX_TOKEN=your-mapbox-public-token

# App Settings
VITE_APP_NAME=Loggi-Flow
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_GAMIFICATION=true
VITE_ENABLE_LALAMOVE=true
VITE_ENABLE_BITRIX24_SYNC=true
