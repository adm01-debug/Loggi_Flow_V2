# ═══════════════════════════════════════════════════════════════
# LOGGI-FLOW - Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Bitrix24
VITE_BITRIX24_WEBHOOK=https://promobrindes.bitrix24.com.br/rest/1/your-token/

# Lalamove (produção)
LALAMOVE_API_KEY=your-api-key
LALAMOVE_API_SECRET=your-api-secret
LALAMOVE_BASE_URL=https://rest.lalamove.com

# Lalamove (sandbox/teste)
# LALAMOVE_BASE_URL=https://sandbox-rest.lalamove.com

# Google Maps (para MapaRotas)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key

# n8n Webhooks
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.com/webhook

# App Settings
VITE_APP_NAME=Loggi-Flow
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_GAMIFICATION=true
VITE_ENABLE_LALAMOVE=true
VITE_ENABLE_BITRIX24_SYNC=true

# Rate Limiting
VITE_API_RATE_LIMIT=100
VITE_API_RATE_WINDOW=60000

# Sentry (Error Tracking)
VITE_SENTRY_DSN=https://your-sentry-dsn

# Analytics
VITE_GA_TRACKING_ID=G-XXXXXXXXXX
